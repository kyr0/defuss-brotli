{
  "name": "defuss-brotli",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "A pure-Rust Brotli WebAssembly package with split compressor/decompressor exports for small build sizes.",
  "author": "Aron Homberg <info@aron-homberg.de>",
  "packageManager": "bun@1.3.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyr0/defuss.git"
  },
  "keywords": [
    "brotli",
    "compression",
    "decompression",
    "rust",
    "wasm",
    "webassembly",
    "isomorphic",
    "npm",
    "defuss"
  ],
  "sideEffects": false,
  "bin": {
    "defuss-brotli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "CHANGELOG.md"
  ],
  "exports": {
    "./compressor": {
      "import": {
        "types": "./dist/compressor.d.ts",
        "default": "./dist/compressor.js"
      }
    },
    "./compressor/slim": {
      "import": {
        "types": "./dist/compressor-slim.d.ts",
        "default": "./dist/compressor-slim.js"
      }
    },
    "./compressor.wasm": "./dist/compressor.wasm",
    "./decompressor": {
      "import": {
        "types": "./dist/decompressor.d.ts",
        "default": "./dist/decompressor.js"
      }
    },
    "./decompressor/slim": {
      "import": {
        "types": "./dist/decompressor-slim.d.ts",
        "default": "./dist/decompressor-slim.js"
      }
    },
    "./decompressor.wasm": "./dist/decompressor.wasm"
  },
  "scripts": {
    "setup": "make setup",
    "clean": "bun scripts/clean.ts",
    "build": "bun scripts/build.ts",
    "pretest": "bun run build",
    "test": "vitest run --coverage",
    "pretest:browser": "bun run build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "example": "bun run build && bun examples/quality-comparison.ts",
    "test:e2e": "make e2e",
    "bench": "bun run build && vitest bench --run --config vitest.bench.config.ts",
    "bench:browser": "bun run build && vitest bench --run --config vitest.bench.browser.config.ts",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@types/node": "^25.4.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "4.11.0",
    "defuss-dom-router": "0.1.1",
    "defuss-i18n": "0.2.0",
    "oxlint": "^1.92.0",
    "playwright": "^1.58.2",
    "shiki": "3.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
